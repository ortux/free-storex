# ════════════════════════════════════════════════════════════════════════════
#  FREE STORE — Production environment file
#  1. Rename this file to  .env
#  2. Fill in every value marked  CHANGE_ME
#  3. Set file permissions to 600 (File Manager → right-click → Change Permissions)
# ════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Your domain — no trailing slash, must be https://
FRONTEND_URL=https://CHANGE_ME.com
UPLOAD_PUBLIC_ORIGIN=https://apif.omrudra.tech

# Random 64-char hex string — keep this private
PROXY_SHARED_SECRET=6430d62264d7f6fcb839f1799f24c8b641932cf3c9152054e7e6bcb7a80a1e30

# ── Database ──────────────────────────────────────────────────────────────────
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# cPanel always prefixes DB name and user with your cPanel username, e.g.:
#   mysql://johnsmith_fsuser:mypassword@localhost:3306/johnsmith_freestore
DATABASE_URL=mysql://CHANGE_ME_USER:CHANGE_ME_PASS@localhost:3306/CHANGE_ME_DBNAME

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at: github.com → Settings → Developer settings → OAuth Apps → New
# Callback URL must be exactly: https://apif.omrudra.tech/auth/github/callback
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_CALLBACK_URL=https://apif.omrudra.tech/auth/github/callback

# ── Session & Encryption ──────────────────────────────────────────────────────
# These are pre-generated — do NOT change them after first login or all
# existing sessions and encrypted files will become invalid.
SESSION_SECRET=78e86dbcd155ed620899aa8f4fe367b3eda2f1db22d1b5473d3fb07295ef8bcd
MASTER_KEY_ENCRYPTION_SECRET=6b5e7197e2f810e8bf8daca3a5a91aec68c951a941a6d1762fee9abd0b874c10
UPLOAD_TOKEN_SECRET=c8aa53e8041007bd8c3d8f531bf2de830099e0d1c71a2d5922be946b56a74b9d

# ── File limits ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=1024
LARGE_FILE_THRESHOLD_MB=20
CHUNK_SIZE_MB=5

# ── Resumable uploads ─────────────────────────────────────────────────────────
UPLOAD_TOKEN_TTL_SECONDS=900
UPLOAD_EXPIRATION_HOURS=24
UPLOAD_CONCURRENCY=3
UPLOAD_MAX_RETRIES=3
CLEANUP_INTERVAL_MINUTES=30

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_UNAUTHENTICATED=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_UPLOAD=30
