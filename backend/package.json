{
  "name": "free-store-backend",
  "version": "1.0.0",
  "description": "GitHub Encrypted Store - Backend API",
  "main": "dist/app.js",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@octokit/rest": "20.1.1",
    "axios": "1.7.9",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csurf": "1.11.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "mysql2": "^3.24.5",
    "nanoid": "3.3.8",
    "passport": "0.7.0",
    "passport-github2": "0.1.12",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/csurf": "1.11.5",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/passport": "1.0.16",
    "@types/passport-github2": "1.2.9",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.2"
  }
}
