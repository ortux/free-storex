# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://root:@localhost:3306/free_store

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ── Session & Encryption ──────────────────────────────────────────────────────
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_64_hex_chars
MASTER_KEY_ENCRYPTION_SECRET=generate_64_hex_chars_different_value

# ── File limits ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=1024
LARGE_FILE_THRESHOLD_MB=20
CHUNK_SIZE_MB=5

# ── Resumable uploads ─────────────────────────────────────────────────────────
UPLOAD_EXPIRATION_HOURS=24
UPLOAD_CONCURRENCY=3
UPLOAD_MAX_RETRIES=3
CLEANUP_INTERVAL_MINUTES=30

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_UNAUTHENTICATED=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_UPLOAD=30
